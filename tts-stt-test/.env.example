# ===== 腾讯云语音服务（TTS 语音合成 / STT 语音识别）=====
# 使用方式: cp .env.example .env 然后填入真实密钥
# 密钥申请/查看: https://console.cloud.tencent.com/cam/capi
# 语音服务开通: https://console.cloud.tencent.com/tts
TENCENT_SECRET_ID=你的腾讯云SecretId
TENCENT_SECRET_KEY=你的腾讯云SecretKey

# 地域（可选，默认上海）
# ap-shanghai（上海）/ ap-guangzhou（广州）/ ap-beijing（北京）
TENCENT_TTS_REGION=ap-shanghai

#腾讯云账号ID
TENCENT_ACCOUNT_ID=你的腾讯云账号ID
