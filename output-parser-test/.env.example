# ===== 大模型 API 配置 =====
# 本项目使用 OpenAI 兼容接口，可对接通义千问、智谱、OpenAI 等任何兼容服务

# API Key（必填）
# 通义千问申请: https://dashscope.console.aliyun.com/apiKey
# OpenAI 官方: https://platform.openai.com/api-keys
# 智谱清言: https://open.bigmodel.cn/usercenter/apikeys
OPENAI_API_KEY=你的APIKey

# 模型名称（必填）
# 通义千问可选: qwen-max / qwen-plus / qwen-turbo / qwen2.5-72b-instruct
# OpenAI 可选: gpt-4o / gpt-4o-mini / gpt-3.5-turbo
# 智谱可选: glm-4-plus / glm-4 / glm-3-turbo
MODEL_NAME=qwen-plus

# 文本嵌入模型（可选，用于向量化/RAG 场景）
# 通义千问支持: text-embedding-v3 / text-embedding-v4
# OpenAI 支持: text-embedding-3-large / text-embedding-3-small
EMBEDDINGS_MODEL_NAME=text-embedding-v3

# 推理服务地址（必填，OpenAI 兼容接口的基础 URL）
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI 官方: https://api.openai.com/v1
# 智谱: https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 其他服务参考（如需切换，改上面三行即可）=====
# 1. OpenAI 官方
# OPENAI_API_KEY=sk-你的OpenAIKey
# MODEL_NAME=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# 2. 智谱清言（GLM）
# OPENAI_API_KEY=你的智谱APIKey
# MODEL_NAME=glm-4-plus
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 数据库配置（可选，部分案例需要）=====
# MySQL 连接信息
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=你的密码
# MYSQL_DATABASE=你的数据库名

# ===== 和风天气 API（可选，weather-mcp-server.mjs 需要）=====
# 官网: https://dev.qweather.com/
# 需开通"和风天气 API"服务，获取 API Key 和项目 ID
# HF_WEATHER_API_HOST=你的网关地址
# HF_WEATHER_APIKEY=你的APIKey
# HF_WEATHER_PROJECT_ID=你的项目ID
# HF_WEATHER_KID=你的凭据ID
# HF_WEATHER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n你的私钥内容\n-----END PRIVATE KEY-----"
# JWT_EXPIRE_SECONDS=600

# ===== 高德地图 MCP（可选，open-mcp-test.mjs 需要）=====
# 申请地址: https://console.amap.com/dev/key/app
# 需开通"Web服务"API，并获取 API Key（注意：是 Web服务Key，不是 JS API Key）
# AMAP_MAPS_API_KEY=你的高德APIKey
# AMAP_REQUEST_DELAY=1000

# ===== 文件系统 MCP 允许访问的路径（可选，open-mcp-test.mjs 需要，逗号分隔）=====
# ALLOWED_PATHS=你的项目路径
