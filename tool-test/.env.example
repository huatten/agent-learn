# ===== 大模型 API 配置 =====
# 使用 OpenAI 兼容接口，可对接通义千问、智谱、OpenAI 等
# 通义千问申请: https://dashscope.console.aliyun.com/apiKey
OPENAI_API_KEY=你的APIKey
MODEL_NAME=qwen-plus
EMBEDDINGS_MODEL_NAME=text-embedding-v3
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 和风天气 API（weather-mcp-server.mjs 需要）=====
# 官网: https://dev.qweather.com/
HF_WEATHER_API_HOST=你的和风天气APIHost
HF_WEATHER_APIKEY=你的和风天气APIKey
HF_WEATHER_PROJECT_ID=你的项目ID
HF_WEATHER_KID=你的凭据ID
# Ed25519 私钥（PKCS8 格式，双引号包裹，行内用 \n 转义换行）
HF_WEATHER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n你的私钥\n-----END PRIVATE KEY-----"
JWT_EXPIRE_SECONDS=600

# ===== 高德地图 MCP（open-mcp-test.mjs 需要）=====
# 申请地址: https://console.amap.com/dev/key/app （需开通 Web服务 API）
AMAP_MAPS_API_KEY=你的高德Key
AMAP_REQUEST_DELAY=1000

# ===== 文件系统 MCP 允许访问的路径（逗号分隔）=====
ALLOWED_PATHS=/绝对路径/到/tool-test
