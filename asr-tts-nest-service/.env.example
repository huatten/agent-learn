# ===== 大模型 API 配置 =====
# 本项目使用 OpenAI 兼容接口，可对接通义千问、智谱、OpenAI 等任何兼容服务

# API Key（必填）
# 通义千问申请: https://dashscope.console.aliyun.com/apiKey
# OpenAI 官方: https://platform.openai.com/api-keys
# 智谱清言: https://open.bigmodel.cn/usercenter/apikeys
OPENAI_API_KEY=你的APIKey

# 模型名称（必填）
# 通义千问可选: qwen-max / qwen-plus / qwen-turbo / qwen2.5-72b-instruct
# OpenAI 可选: gpt-4o / gpt-4o-mini / gpt-3.5-turbo
# 智谱可选: glm-4-plus / glm-4 / glm-3-turbo
MODEL_NAME=qwen-plus

# 文本嵌入模型（可选，用于向量化/RAG 场景）
# 通义千问支持: text-embedding-v3 / text-embedding-v4
# OpenAI 支持: text-embedding-3-large / text-embedding-3-small
EMBEDDINGS_MODEL_NAME=text-embedding-v3

# 推理服务地址（必填，OpenAI 兼容接口的基础 URL）
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI 官方: https://api.openai.com/v1
# 智谱: https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 腾讯云语音服务（TTS 语音合成 / STT 语音识别）=====
# 使用方式: cp .env.example .env 然后填入真实密钥
# 密钥申请/查看: https://console.cloud.tencent.com/cam/capi
# 语音服务开通: https://console.cloud.tencent.com/tts
TENCENT_SECRET_ID=你的腾讯云SecretId
TENCENT_SECRET_KEY=你的腾讯云SecretKey

# 地域（可选，默认上海）
# ap-shanghai（上海）/ ap-guangzhou（广州）/ ap-beijing（北京）
TENCENT_TTS_REGION=ap-shanghai

#腾讯云账号ID
TENCENT_ACCOUNT_ID=你的腾讯云账号ID

# ===== 流式 TTS 合成参数（可选，作为服务端默认值，前端界面可再覆盖）=====
# 音色 ID：101001 智瑜·情感女声 / 101002 智聆·通用女声 / 101004 智云·通用男声 / 502001 智小柔·聊天女声 等
# 完整列表见 https://cloud.tencent.com/document/product/1073/92668
TENCENT_TTS_VOICE_TYPE=101001
# 语速，取值范围 [-2, 6]，0 为正常
TENCENT_TTS_SPEED=0
# 音量，取值范围 [0, 10]，默认 5
TENCENT_TTS_VOLUME=5
# 采样率，默认 16000
TENCENT_TTS_SAMPLE_RATE=16000
# 输出编码，默认 mp3（前端 MSE 按 audio/mpeg 播放）
TENCENT_TTS_CODEC=mp3
