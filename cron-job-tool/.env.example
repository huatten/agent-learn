# ===== 大模型 API 配置 =====
# 本项目使用 OpenAI 兼容接口，可对接通义千问、智谱、OpenAI 等任何兼容服务

# API Key（必填）
# 通义千问申请: https://dashscope.console.aliyun.com/apiKey
# OpenAI 官方: https://platform.openai.com/api-keys
# 智谱清言: https://open.bigmodel.cn/usercenter/apikeys
OPENAI_API_KEY=你的APIKey

# 模型名称（必填）
# 通义千问可选: qwen-max / qwen-plus / qwen-turbo / qwen2.5-72b-instruct
# OpenAI 可选: gpt-4o / gpt-4o-mini / gpt-3.5-turbo
# 智谱可选: glm-4-plus / glm-4 / glm-3-turbo
MODEL_NAME=qwen-plus

# 文本嵌入模型（可选，用于向量化/RAG 场景）
# 通义千问支持: text-embedding-v3 / text-embedding-v4
# OpenAI 支持: text-embedding-3-large / text-embedding-3-small
EMBEDDINGS_MODEL_NAME=text-embedding-v3

# 推理服务地址（必填，OpenAI 兼容接口的基础 URL）
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI 官方: https://api.openai.com/v1
# 智谱: https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ===== 邮件发送配置（send-mail-tool.service.ts 需要）=====
# SMTP 服务器地址（QQ 邮箱: smtp.qq.com，网易: smtp.163.com，Gmail: smtp.gmail.com）
MAIL_HOST=smtp.qq.com
# SMTP 端口（SSL: 465，TLS: 587，普通: 25）
MAIL_PORT=587
# 是否使用 SSL（QQ 邮箱用 TLS 时设为 false，用 SSL 时设为 true 并改端口为 465）
MAIL_SECURE=false
# 邮箱账号（发件人邮箱）
MAIL_USER=你的邮箱@qq.com
# 邮箱授权码（注意：不是登录密码！QQ 邮箱在"设置→账户→POP3/IMAP/SMTP"中开启服务后获取）
MAIL_PASS=你的邮箱授权码
# 发件人显示名称（格式: "显示名" <邮箱地址>）
MAIL_FROM="No Reply" <你的邮箱@qq.com>


# ===== 博查 Web 搜索 API（websearch-tool.service.ts 需要）=====
# 官网: https://open.bochaai.com/
# 在"API Keys"页面创建密钥
BOCHA_WEB_SEARCH_API_KEY=你的博查搜索APIKey


# ===== 数据库配置（db-users-crud-tool.service.ts 需要）=====
# MySQL 连接信息（用于用户 CRUD 工具演示）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=你的数据库密码
DB_NAME=你的数据库名
