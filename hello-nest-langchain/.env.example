# ===== 大模型 API 配置 =====
# 本项目使用 OpenAI 兼容接口，可对接通义千问、智谱、OpenAI 等任何兼容服务

# API Key（必填）
# 通义千问申请: https://dashscope.console.aliyun.com/apiKey
# OpenAI 官方: https://platform.openai.com/api-keys
# 智谱清言: https://open.bigmodel.cn/usercenter/apikeys
OPENAI_API_KEY=你的APIKey

# 模型名称（必填）
# 通义千问可选: qwen-max / qwen-plus / qwen-turbo / qwen2.5-72b-instruct
# OpenAI 可选: gpt-4o / gpt-4o-mini / gpt-3.5-turbo
# 智谱可选: glm-4-plus / glm-4 / glm-3-turbo
MODEL_NAME=qwen-plus

# 文本嵌入模型（可选，用于向量化/RAG 场景）
# 通义千问支持: text-embedding-v3 / text-embedding-v4
# OpenAI 支持: text-embedding-3-large / text-embedding-3-small
EMBEDDINGS_MODEL_NAME=text-embedding-v3

# 推理服务地址（必填，OpenAI 兼容接口的基础 URL）
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI 官方: https://api.openai.com/v1
# 智谱: https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
